# JWT 签名密钥（生产环境务必修改）
JWT_SECRET=fire-agent-platform-secret-key-change-in-prod

# 数据库连接
DATABASE_URL=your_database_url # 数据库连接字符串
# 数据库连接字符串 例如：postgresql://postgres:my_password@localhost:5432/my_db

# 高德地图 Key（天气/定位，与前端一致）
AMAP_KEY=your_amap_key

# 大模型 API（阿里百炼，兼容 OpenAI 接口格式）
LLM_API_KEY=your_llm_api_key
LLM_API_BASE='https://dashscope.aliyuncs.com/compatible-mode/v1'
LLM_MODEL='qwen-plus' # 大模型名称
EMBEDDING_MODEL='text-embedding-v3' # 嵌入模型名称
# 视觉 / 语音模型（恒定阿里百炼，用于火情图像识别 / 语音输入 / 语音播报）
VISION_MODEL='qwen-vl-plus' # 视觉模型名称
ASR_MODEL='qwen3-asr-flash' # 语音识别模型名称
TTS_MODEL='qwen3-tts-flash' # 语音合成模型名称


# 活跃 LLM 提供商（aliyun | amd）
ACTIVE_LLM_PROVIDER='ollama' # 活跃 LLM 提供商

# AMD GPU Cloud（兼容 OpenAI 接口格式） （可选）
# 如果不使用 AMD GPU Cloud，可注释掉以下行
# AMD提供免费的DeepSeek-V4-Flash模型和限时免费的Qwen3.8-Flash-Next模型
# https://developer.amd.com.cn/radeon/tokenfactory?source=cherry-studio 获取 API Key
AMD_API_KEY=your_amd_api_key # AMD API Key
AMD_API_BASE='https://developer.amd.com.cn/radeon/v1' # AMD API Base URL
AMD_MODEL='DeepSeek-V4-Flash' # AMD 模型名称

# Qwen3.8-Flash-Next 可用时间窗口（空表示不限，格式: YYYY-MM-DD HH:MM:SS）
QWEN3_8_FLASH_START=
QWEN3_8_FLASH_END=
KB_CHUNK_SIZE='500'
KB_CHUNK_OVERLAP='50'
KB_TOP_K='5'

# 本地 Ollama 模型 （可选）
# 如果不使用本地 Ollama 模型，可注释掉以下行
OLLAMA_API_BASE='http://localhost:11434/v1' # Ollama API Base URL
OLLAMA_MODEL='deepseek-r1:1.5b' # Ollama 模型名称
